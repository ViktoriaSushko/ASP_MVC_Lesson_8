@model ASP_MVC_Lesson_8.Models.ViewModel.CreateCatVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Cat</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Cat!.CatName" class="control-label"></label>
                <input asp-for="Cat!.CatName" class="form-control" />
                <span asp-validation-for="Cat!.CatName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Cat!.Description" class="control-label"></label>
                <textarea asp-for="Cat!.Description" class="form-control"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Cat!.BreedId" class="control-label">Breed</label>
                <select asp-for="Cat!.BreedId" asp-items="Model.Breeds" class="form-control"></select>
            </div>

            <div class="form-group">
                <label asp-for="Cat!.Gender" class="control-label"></label>    
                <select asp-for="Cat!.Gender" asp-items="Model.CatsGenders" class="form-control"></select>
            </div>

            <div class="form-group">
                <label asp-for="Cat!.IsVacinated" class="control-label"></label>
                <input asp-for="Cat!.IsVacinated"/>
            </div>

            <div class="form-group">
                <label>Image</label>
                <input type="file" name="imageFile" id="Image" accept="image/*" />
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
