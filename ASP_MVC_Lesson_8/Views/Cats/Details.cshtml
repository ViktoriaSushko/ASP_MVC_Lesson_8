@using ASP_MVC_Lesson_8.Models.DTOs;
@model CatDTO

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Cat</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CatName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.CatName)</dd>

        <dt class="col-sm-2">Breed</dt>
        <dd class="col-sm-10">@Model.Breed?.BreedName</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Gender)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Gender)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.IsVacinated)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.IsVacinated)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>

        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">
            @if (Model.Image != null)
            {
                <img src="data:image;base64,@(Convert.ToBase64String(Model.Image))" style="max-width:300px;max-height:300px;" />
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
